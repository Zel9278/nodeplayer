[Desktop Entry]
Type=Application
Name=nodeplayer
Comment=Node-graph audio player with DSP nodes and VST3, CLAP and JSFX plugins
Exec=nodeplayer %f
Icon=nodeplayer
Terminal=false
Categories=AudioVideo;Audio;Player;
